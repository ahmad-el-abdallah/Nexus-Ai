# NEXUS AI backend configuration.
# Copy to backend/.env (`make setup` does this for you). Never commit backend/.env.

# --- Runtime ------------------------------------------------------------------
NEXUS_ENV=development              # development | test | production
NEXUS_HOST=127.0.0.1               # bind address; keep 127.0.0.1 unless you know you need LAN access
NEXUS_PORT=8000
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_FORMAT=console           # console | json
NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where you open NEXUS in the browser. Email OAuth sign-ins return to
# $NEXUS_PUBLIC_URL/api/email/oauth/callback — register that exact URI with Google/Microsoft.
NEXUS_PUBLIC_URL=http://localhost:3000
# Brevo's API for sending email (only change it for testing).
# NEXUS_BREVO_API_URL=https://api.brevo.com/v3

# Apps built by the engineering team. A running app is reached at
# http://localhost:$NEXUS_PREVIEW_PORT (bound to 127.0.0.1); its files, installed packages
# and stored data live in $NEXUS_APPS_DIR (default: backend/var/apps).
# NEXUS_PREVIEW_PORT=8100
# NEXUS_APPS_DIR=

# --- Database -----------------------------------------------------------------
# Default: SQLite file at backend/var/nexus.db (leave unset to use it).
# NEXUS_DATABASE_URL=sqlite+aiosqlite:///./var/nexus.db
# PostgreSQL (optional): NEXUS_DATABASE_URL=postgresql+asyncpg://USER@localhost:5432/nexus_ai

# --- Data Center / Digital Vault --------------------------------------------
# DC-1 establishes this private storage contract; file operations arrive in later
# DC stages. Relative paths are resolved from backend/. Real file bytes must stay
# outside web roots and are addressed internally by opaque keys only.
NEXUS_STORAGE_BACKEND=local
# NEXUS_STORAGE_ROOT=var/storage
NEXUS_STORAGE_MAX_FILE_BYTES=104857600
NEXUS_STORAGE_DEPARTMENT_QUOTA_BYTES=10737418240
NEXUS_STORAGE_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.xlsx,.csv,.pptx,.png,.jpg,.jpeg,.webp,.svg,.mp4,.webm,.mp3,.wav,.py,.js,.ts,.tsx,.jsx,.html,.css,.json,.sql,.zip
# Optional future backup destination. Keep it outside NEXUS_STORAGE_ROOT. Leaving it
# unset truthfully means no Vault backup is configured.
# NEXUS_STORAGE_BACKUP_ROOT=var/storage-backups

# --- Secrets ------------------------------------------------------------------
# Master key for encrypting credentials stored server-side (email OAuth tokens etc.).
# `make setup` generates a random value locally. Keep it private and backed up:
# losing it makes stored credentials unreadable.
NEXUS_SECRET_KEY=

# --- AI provider: NVIDIA ----------------------------------------------------------
# Create a key at https://build.nvidia.com. Read server-side only; never exposed to the browser.
# You can instead save a key in Settings → AI providers (stored encrypted with NEXUS_SECRET_KEY);
# a key saved in the app takes precedence over this one.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
